.DS_Store
.venv/
__pycache__/
*.pyc
server.log
.env

# internal docs
internal_docs/

# Loaded from disk, not from git — ignoring them does not disable them.
# Not versioned: back these up outside git.
.claude/
CLAUDE.md
CLAUDE.local.md

# obsidian vault config for internal_docs/
.obsidian/

# generated dashboard fixture (server reads Postgres now)
fixtures/

# seed tag list: files that scripts/build_seed_tags.py rebuilds
tags/*/results/chunks/
tags/*/results/merge_in/
tags/*/atlas/tags.json

# one-off loader of the extraction folders, not part of the repo
db_load/

tags/linking/results/*
!tags/linking/results/links_q1_2026-10-04.tsv

# near-duplicate tags: scripts/split_vote_pairs.py rebuilds the run outputs. The accepted merges live in data/.
tags/near_duplicates/results/*
# working file of the manual review
tags/near_duplicates/REVIEW_GUIDE.md

# subject groups: scripts/subject_groups.py and scripts/subject_join.py rebuild the run outputs.
# The LLM join answers that cost a model run live in tags/subject_groups/data/.
tags/subject_groups/results/*
# labels and ratings of the blind reviews that chose the settings
tags/subject_groups/eval/
