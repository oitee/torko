# Copy this file to .env and set a real password.
# docker-compose.yml and db.py both read these variables.
POSTGRES_USER=postgres
POSTGRES_DB=torko
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Memory cap for the database container.
POSTGRES_MEM_LIMIT=2g
# Google AI Studio key for gemini-embedding-001 (tag_embed.py).
GEMINI_API_KEY=
# API key of the decision model (decision_model.py). The tag steps need it.
TYPESAFE_API_KEY=
# Flask debug mode for server.py: true or false. Set false on any server that others can reach.
FLASK_DEBUG=true
# The API docs at /api/openapi.json and /api/docs/: true or false. The default is false. Set true only on your own machine.
API_DOCS=true
# The public address of the site and the contact email. The site in web/ reads these when Vite builds it. server.py also reads VITE_SITE_URL for the addresses in /sitemap.xml.
VITE_SITE_URL=https://torko.in
VITE_CONTACT_EMAIL=hello@otee.dev
# The token of Cloudflare Web Analytics. The site loads the analytics script only when this value is set and the page runs on the host of VITE_SITE_URL. Leave it empty to count no visits.
VITE_CF_ANALYTICS_TOKEN=
